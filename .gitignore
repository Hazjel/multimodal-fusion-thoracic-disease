# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
env/
.venv/

# Jupyter
.ipynb_checkpoints/

# Model checkpoints & pretrained weights (large binary files)
results/checkpoints/*.pt
results/checkpoints/*.pkl
results/**/*.pt
results/**/*.pkl
models/model.pth.tar
models/scaler_tabular.pkl

# Raw dataset images (too large, download from Kaggle/NIH)
data/raw/
data/images/
*.dcm
*.png.zip

# Processed data & XAI array dumps (regenerable, large)
data/processed/*.csv
results/xai/*.npy

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log
logs/

# Row-level research evidence stays local (aggregate results are publishable)
results/canonical/*/secondary_holdout/*/predictions.csv
results/canonical/*/secondary_holdout/official_test_manifest.csv
results/canonical/*/deployment/runs/*/validation_predictions.csv
results/canonical/*/deployment/shap_background_cases.csv
results/canonical/*/deployment/shap_background_scaled.npy

# Per-fold C5 run state is several GB and is reproducible from published OOF
# aggregates, registry entries, and the frozen protocol.
results/canonical/*/runs/C5-*/

# Generated C0 scratch/report state (freeze artifacts are kept separately)
results/c0/
results/canonical/.staging/
